{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/565721014-art/shhh-strategy/references/regression-observation.schema.json",
  "title": "Shhh Strategy Regression Observation",
  "type": "object",
  "required": ["format", "version", "evaluation_status", "cases"],
  "properties": {
    "format": {"const": "shhh-strategy-regression-observation"},
    "version": {"type": "string", "minLength": 1},
    "evaluation_status": {"enum": ["development", "blind", "contaminated"]},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["case_id", "mechanism_family", "scores", "critical_failures", "evidence"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "mechanism_family": {"type": "string", "minLength": 1},
          "scores": {
            "type": "object",
            "required": ["source_integrity", "problem_lock", "trigger_fidelity", "route_executability", "complexity_discipline", "claim_boundary", "confirmation_discipline", "state_continuity"],
            "properties": {
              "source_integrity": {"type": "integer", "minimum": 0, "maximum": 4},
              "problem_lock": {"type": "integer", "minimum": 0, "maximum": 4},
              "trigger_fidelity": {"type": "integer", "minimum": 0, "maximum": 4},
              "route_executability": {"type": "integer", "minimum": 0, "maximum": 4},
              "complexity_discipline": {"type": "integer", "minimum": 0, "maximum": 4},
              "claim_boundary": {"type": "integer", "minimum": 0, "maximum": 4},
              "confirmation_discipline": {"type": "integer", "minimum": 0, "maximum": 4},
              "state_continuity": {"type": "integer", "minimum": 0, "maximum": 4}
            },
            "additionalProperties": false
          },
          "critical_failures": {"type": "array", "items": {"type": "string"}},
          "evidence": {"type": "array", "items": {"type": "string"}, "minItems": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
